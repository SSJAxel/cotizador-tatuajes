DATABASE_URL="postgresql://cotizador:cotizador@localhost:5433/cotizador"
PORT=4000
# Cualquier string largo y random sirve en dev. En producción, generar uno
# propio y no versionarlo (ver .env, que ya está en .gitignore).
JWT_SECRET="cambiar-esto-por-un-secreto-random-largo"

# SMTP para el mail de "olvidé mi contraseña". En dev apunta a MailHog (ver
# docker-compose.yml de booking-saas, que ya lo levanta en estos puertos) —
# los mails no salen a internet, se ven en http://localhost:8025. En
# producción, reemplazar por las credenciales de un proveedor real.
SMTP_HOST="localhost"
SMTP_PORT=1025
CLIENT_URL="http://localhost:5173"
